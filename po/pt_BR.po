msgstr "formato do arquivo gerado"

#. possible choice for format
msgid "ai"
msgstr "ai"

#. possible choice for format
msgid "dxf"
msgstr "dxf"

#. possible choice for format
msgid "gcode"
msgstr "gcode"

#. possible choice for format

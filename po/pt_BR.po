msgid "DefaultParams Settings"
msgstr "Configurações dos Parâmetros Padrão"

#. parameter name
msgid "x"
msgstr "x"

#. help for parameter x
msgid "inner width in mm (unless outside selected)"
msgstr "largura interna em mm (a menos que a opção de medida externa esteja selecionada)"

#. parameter name
msgid "y"
msgstr "y"

#. help for parameter y
msgid "inner depth in mm (unless outside selected)"
msgstr "profundidade interna em mm (a menos que a opção de medida externa esteja selecionada)"

#. parameter name
msgid "h"
msgstr "h"

#. help for parameter h
msgid "inner height in mm (unless outside selected)"
msgstr "altura interna em mm (a menos que a opção de medida externa esteja selecionada)"

#. parameter name
msgid "hi"
msgstr "hi"

#. help for parameter hi
msgid ""
"inner height of inner walls in mm (unless outside selected)(leave to zero "
"for same as outer walls)"
msgstr ""
"altura interna das paredes internas em mm (a menos que a opção de medida externa esteja selecionada)(deixe como zero "
"para usar a mesma altura das paredes externas)"

#. parameter name
msgid "sx"
msgstr "sx"

#. help for parameter sx
msgid "sections left to right in mm. See --sy for format"
msgstr "seções da esquerda para a direita em mm. Consulte --sy para o formato"

#. parameter name
msgid "sy"
msgstr "sy"

#. help for parameter sy
msgid ""
"sections back to front in mm. Possible formats: overallwidth/numberof "
"sections e.g. \"250/5\"; sectionwidth*numberofsections e.g. \"50*5\"; "
"section widths separated by \":\" e.g. \"30:25.5:70"
msgstr ""
"seções de trás para frente em mm. Formatos possíveis: largura total/número de "
"seções, por exemplo \"250/5\"; largura da seção*número de seções, por exemplo \"50*5\"; "
"larguras das seções separadas por \":\", por exemplo \"30:25.5:70"

#. parameter name
msgid "sh"
msgstr "sh"

#. help for parameter sh
msgid "sections bottom to top in mm. See --sy for format"
msgstr "seções de baixo para cima em mm. Consulte --sy para o formato"

#. parameter name
msgid "bottom_edge"
msgstr "Borda Inferior"

#. help for parameter bottom_edge
msgid "edge type for bottom edge"
msgstr "tipo de borda para a borda inferior"


msgstr "Maior que zero para deixar a parte superior mais larga que a inferior"

#. name of box generator
#: boxes/generators/displaycase.py
msgid "DisplayCase"
msgstr "Vitrine"

#. description of DisplayCase
#: boxes/generators/displaycase.py

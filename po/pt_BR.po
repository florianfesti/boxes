msgid "play"
msgstr "liberdade de movimento"

#. help for parameter play
msgid "extra space to allow movement"
msgstr "espaço extra para permitir movimento"

#. parameter name for FingerJoint
msgid "space"
msgstr "espaço"

#. help for parameter space
msgid "space between fingers"
msgstr "espaço entre os dedos"

#. parameter name for FingerJoint
msgid "width"
msgstr "largura"

#. help for parameter width
msgid "width of finger holes"
msgstr "largura dos furos dos dentes"

msgid "Settings for Stackable Edges"
msgstr "Configurações para Bordas Empilháveis"

#. help for parameter angle
msgid "inside angle of the feet"
msgstr "ângulo interno dos pés"

#. parameter name for Stackable
msgid "height"
msgstr "altura"

#. help for parameter height
msgid "height of the feet"
msgstr "altura dos pés de apoio"

#. parameter name for Stackable
msgid "holedistance"
msgstr "distancia entre furos"

#. help for parameter holedistance
msgid "distance from finger holes to bottom edge"
msgstr "distância dos furos dos dedos até a borda inferior"

#. help for parameter width
msgid "width of the feet"
msgstr "largura dos pés"

msgid "Settings for Hinges and HingePins"
msgstr "Configurações para Dobradiças e Pinos de Dobradiça"

#. parameter name for Hinge
msgid "grip_percentage"
msgstr "Percentual Aderência"

#. parameter name for Hinge
msgid "outset"
msgstr "início"

#. help for parameter outset
msgid "have lid overlap at the sides (similar to OutSetEdge)"
msgstr "fazer a tampa sobrepor as laterais (semelhante a BordaInicial)"

#. parameter name for Hinge
msgid "pinwidth"
msgstr "Largura Pino"

#. help for parameter pinwidth
msgid "set to lower value to get disks surrounding the pins"
msgstr "defina um valor menor para obter discos ao redor dos pinos"

#. parameter name for Hinge
msgid "style"
msgstr "estilo"

#. help for parameter style
msgid "\"outset\" or \"flush\""
msgstr "\"início\" ou \"nivelado\""

#. possible choice for style
msgid "flush"
msgstr "Descarga"

#. parameter name for Hinge
msgid "axle"
msgstr "Eixo"

#. help for parameter axle
msgid "diameter of the pin hole"
msgstr "diâmetro do furo do pino"

#. parameter name for Hinge
msgid "grip_length"
msgstr "Comprimento Alças"

#. help for parameter grip_length
msgid "fixed length of the grips on he lids"
msgstr "comprimento fixo das alças nas tampas"

#. parameter name for Hinge
msgid "hingestrength"
msgstr "Resistência Dobradiça"

#. help for parameter hingestrength
msgid "thickness of the arc holding the pin in place"
msgstr "espessura do arco que mantém o pino no lugar"

msgid "Settings for Slide-on Lids"
msgstr "Configurações para Tampas Deslizantes"

#. parameter name for Lid
msgid "second_pin"
msgstr "Segundo Pino"

#. parameter name for Lid
msgid "spring"
msgstr "mola"

#. possible choice for spring

msgstr "svg_Ponoko"

#. parameter name
msgid "tabs"
msgstr "tabulação"

#. help for parameter tabs
msgid ""
"width of tabs holding the parts in place in mm (not supported everywhere)"
msgstr ""
"largura das abas que mantêm as peças no lugar em mm (não suportado em todos os casos)"

#. parameter name
msgid "debug"
msgstr "debugar"

#. help for parameter debug
msgid "print surrounding boxes for some structures"
msgstr "imprimir caixas de contorno para algumas estruturas"

#. parameter name
msgid "reference"
msgstr "referência"

#. help for parameter reference
msgid "print reference rectangle with given length (zero to disable)"
msgstr "imprimir um retângulo de referência com o comprimento informado (zero para desativar)"

#. parameter name
msgid "burn"
msgstr "gravar"

#. help for parameter burn
msgid "burn correction in mm (bigger values for tighter fit)"
msgstr "correção da queima em mm (valores maiores proporcionam um encaixe mais justo)"

msgid "Settings for Finger Joints"
msgstr "Configurações para Encaixes Dentados"

#. parameter name for FingerJoint
msgid "angle"
msgstr "ângulo"

#. parameter name for FingerJoint
msgid "surroundingspaces"
msgstr "espaços circundantes"

#. help for parameter surroundingspaces
msgid "maximum space at the start and end in multiple of normal spaces"
msgstr "espaço máximo no início e no fim, em múltiplos do espaçamento normal"

#. parameter name for FingerJoint
msgid "edge_width"
msgstr "Largura Borda"

#. help for parameter edge_width
msgid "space below holes of FingerHoleEdge"
msgstr "espaço abaixo dos furos da FingerHoleEdge"

#. parameter name for FingerJoint
msgid "finger"
msgstr "dedo"

#. help for parameter finger
msgid "width of the fingers"
msgstr "largura dos dedos"

